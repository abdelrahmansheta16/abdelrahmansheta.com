# Copy to .env.local. Never commit real values. All server-only unless prefixed NEXT_PUBLIC_.
KNOWLEDGE_DIR=../portfolio-corpus            # local path to the private corpus (dev); CI/Vercel use CORPUS_REPO_TOKEN
CORPUS_REPO_TOKEN=                           # fine-grained read-only PAT for abdelrahmansheta16/portfolio-corpus
# The brain's two model slots, named by ROLE. Both currently run on one Alibaba Cloud Model Studio
# (international) account, so the two keys are the same value; only the model differs. The primary is
# DeepSeek V4 Flash served from Singapore rather than api.deepseek.com, which keeps visitor speech out
# of the PRC — see docs/ARCHITECTURE.md.
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
ANTHROPIC_API_KEY=                           # optional third choice; used as the backup only when LLM_FALLBACK_API_KEY is unset
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=                         # Professional Voice Clone id used by scripts/push-agent-config.ts
ELEVENLABS_WEBHOOK_SECRET=
LLM_ADAPTER_SECRET=                          # X-Agent-Key ElevenLabs sends to /api/llm
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=                    # admin auth only
NEXT_PUBLIC_SUPABASE_ANON_KEY=
RESEND_API_KEY=
LLM_PRIMARY_MODEL=deepseek-v4-flash          # optional pin; defaults to deepseek-v4-flash
LLM_FALLBACK_MODEL=qwen3.8-flash             # optional pin; defaults to qwen3.8-flash
ANTHROPIC_MODEL=claude-haiku-4-5             # optional pin; defaults to claude-haiku-4-5
RESEND_FROM=portfolio@send.abdelrahmansheta.com
OWNER_EMAIL=
VISITOR_COOKIE_SECRET=
IP_HASH_SALT=
NEXT_PUBLIC_VOICE_ENABLED=0                  # 1 turns the voice path on; text chat works either way
CAL_URL=
SITE_URL=https://abdelrahmansheta.com       # public origin; used to build the custom-LLM URL in the agent config
CRON_SECRET=
