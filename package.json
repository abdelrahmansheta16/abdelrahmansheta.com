    "@elevenlabs/client": "^1.24.0",
    "@elevenlabs/elevenlabs-js": "^2.66.0",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "ai": "^7.0.93",
    "botid": "^1.5.11",
    "gray-matter": "^4.0.3",
    "js-tiktoken": "^1.0.21",
    "libphonenumber-js": "^1.13.12",
    "motion": "^13.2.0",
